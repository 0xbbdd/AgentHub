{
  "name": "agenthub",
  "version": "1.82.2",
  "description": "AgentHub —— Agent中控台：技能仓库 / 用量同步 / 反代网关 / 记忆中枢",
  "author": "沐晖",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node tools/dev.cjs",
    "dev:web": "vite",
    "web": "vite --open",
    "build": "npm run verify:platform && npm run check:sfc && npm run check:ipc && vue-tsc --noEmit && vite build",
    "check:sfc": "node tools/check-sfc-components.cjs",
    "check:ipc": "node tools/check-ipc-commands.cjs",
    "check:platform": "node tools/check-platform-boundaries.cjs",
    "verify:platform": "npm run check:platform && node tools/check-platform-capabilities.cjs && node tools/platform-services-selftest.cjs && node tools/platform-process-selftest.cjs && node tools/chromium-crypto-selftest.cjs",
    "platform:matrix": "node tools/print-platform-capabilities.cjs --all",
    "platform:credential-check": "node tools/platform-credential-diagnose.cjs --attempt",
    "platform:qoder-signer-check": "node tools/qoder-signer-acceptance.cjs --load-glue",
    "release:assemble": "node tools/assemble-release.cjs",
    "release:verify": "node tools/release-artifacts-selftest.cjs && node tools/release-signing-selftest.cjs && node tools/release-install-script-selftest.cjs && node tools/update-utils-selftest.cjs && node tools/secure-storage-selftest.cjs && node tools/crashlog-redaction-selftest.cjs && node tools/window-mode-selftest.cjs && node tools/release-workflow-selftest.cjs",
    "security:storage-check": "node tools/secure-storage-selftest.cjs && node tools/crashlog-redaction-selftest.cjs",
    "release:updater-e2e": "node tools/updater-e2e-smoke.cjs",
    "release:updater-e2e:win": "node tools/updater-e2e-win.cjs",
    "release:updater-e2e:mac": "node tools/updater-e2e-mac.cjs",
    "e2e:electron": "node tools/electron-gui-e2e.cjs",
    "e2e:window-mode": "node tools/window-mode-e2e.cjs",
    "e2e:window-mode:main": "node tools/window-mode-main-e2e.cjs",
    "e2e:secure-storage": "electron tools/electron-secure-storage-e2e.cjs",
    "preview": "vite preview",
    "electron:build": "npm run build && npm run native:prepare && electron-builder",
    "electron:pack": "npm run build && npm run native:prepare && electron-builder --dir",
    "gen:icon": "node tools/gen-icon.cjs",
    "verify:memory": "node tools/verify/m-run-all.cjs",
    "electron:build:win": "npm run build && npm run native:prepare:win:x64 && electron-builder --win nsis --x64",
    "electron:build:mac": "npm run build && npm run native:prepare && electron-builder --mac dmg zip",
    "electron:build:mac:x64": "npm run build && npm run native:prepare:mac:x64 && electron-builder --mac dmg zip --x64",
    "electron:build:mac:arm64": "npm run build && npm run native:prepare:mac:arm64 && electron-builder --mac dmg zip --arm64",
    "electron:build:linux": "npm run build && npm run native:prepare:linux:x64 && electron-builder --linux AppImage deb --x64",
    "electron:pack:current": "npm run build && npm run native:prepare && electron-builder --dir",
    "native:prepare": "node tools/prepare-native-resources.cjs",
    "native:prepare:win:x64": "node tools/prepare-native-resources.cjs --platform=win32 --arch=x64",
    "native:prepare:mac:x64": "node tools/prepare-native-resources.cjs --platform=darwin --arch=x64",
    "native:prepare:mac:arm64": "node tools/prepare-native-resources.cjs --platform=darwin --arch=arm64",
    "native:prepare:linux:x64": "node tools/prepare-native-resources.cjs --platform=linux --arch=x64",
    "native:verify": "node tools/verify-native-resources.cjs",
    "native:smoke": "node tools/smoke-sqlcipher.cjs"
  },
  "dependencies": {
    "@vueuse/core": "^11.3.0",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "koffi": "^3.2.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "concurrently": "^8.2.2",
    "echarts": "^5.4.3",
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3",
    "element-plus": "^2.14.5",
    "js-yaml": "^4.3.2",
    "pinia": "^2.1.7",
    "playwright-core": "^1.64.1",
    "typescript": "~5.3.3",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^4.5.3",
    "vue": "^3.4.21",
    "vue-tsc": "^1.8.27",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "build": {
    "appId": "com.huidada1.agenthub",
    "productName": "AgentHub",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "0xbbdd",
        "repo": "AgentHub",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/@koromix/**"
    ],
    "afterSign": "build/notarize.cjs",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "build/tray.png"
      },
      {
        "from": "build/native-resources/sqlcipher",
        "to": "sqlcipher"
      },
      {
        "from": "tools/mcp-memory-server.cjs",
        "to": "mcp/mcp-memory-server.cjs"
      }
    ],
    "win": {
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentHub"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "沐晖",
      "synopsis": "AgentHub Agent control center"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
